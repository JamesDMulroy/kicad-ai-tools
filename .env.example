# kicad-ai-tools configuration. Every value is optional: `python -m kicad_mcp.setup` discovers KiCad and
# writes a per-machine config file; set a variable only to override it. Nothing here is read from .env
# automatically - export it in the environment of the MCP client or the shell.

# KiCad install root (contains bin/ on Windows). Optional; default: discovered (Windows: KiCad's uninstall
# registry entries, then kicad-cli on PATH).
# KICAD_APP_PATH=

# Exact kicad-cli executable. Optional; default: <KiCad root>/bin/kicad-cli.
# KICAD_CLI_PATH=

# KiCad documents home (KiCad itself honours this). Optional; default: the OS Documents folder.
# KICAD_DOCUMENTS_HOME=

# Per-machine config file location. Optional; default: <user config dir>/kicad-ai-tools/config.json.
# KICAD_AI_TOOLS_CONFIG=

# Per-user data (tool manifest cache, workflow jobs). Optional; default: <user data dir>/kicad-ai-tools.
# KICAD_AI_TOOLS_DATA_DIR=

# Seconds an unused MCP server keeps running before the launcher stops it. Optional; default: 600.
# KICAD_AI_TOOLS_SERVER_IDLE_SECONDS=

# Interpreter that runs the MCP server; it must have kicad-ai-tools and its dependencies installed.
# Optional; default: python.exe beside the launcher's pythonw.exe, else the launcher's own interpreter.
# KICAD_AI_TOOLS_SERVER_PYTHON=

# Optional BoardTooling workflow (contracts, gates, release). Optional; absent = those tools report
# "not configured". Get it from the BoardTooling distribution you use.
# KICAD_AI_TOOLS_BOARDTOOLING_ROOT=

# Extra L4 UI-registry approvals (comma-separated sha256), for a registry you re-recorded yourself.
# Optional; the shipped registry is approved by kicad_mcp/l4/registry/APPROVED.sha256.
# KICAD_MCP_L4_APPROVED_REGISTRY_SHA256=

# Your KiCad documents folder. Optional; default: <OS Documents>/KiCad.
# KICAD_USER_DIR=

# KiCad's bundled python (pcbnew). Optional; default: <KiCad root>/bin/python.exe on Windows.
# KICAD_AI_TOOLS_KICAD_PYTHON=

# Workflow job journals. Optional; default: <data dir>/workflow-jobs.
# KICAD_MCP_JOB_DIR=

# BoardTooling release exporter interpreter (needs cryptography) and PowerShell 7 for gates. Optional;
# defaults: the server's interpreter, and pwsh on PATH.
# KICAD_AI_TOOLS_EXPORT_PYTHON=
# KICAD_AI_TOOLS_POWERSHELL=

# BoardTooling trust settings, managed by whoever runs the server; nothing is installed for you.
# Optional; absent = release/attestation operations refuse.
# BOARDTOOLING_TRUST_CONFIG=
# BOARDTOOLING_VISUAL_REVIEW_PUBLIC_KEY=

# Allow kicad_run_bom_generator to start the external BOM generator program a client names. Off unless "1".
# The tool's own allow_execute argument is chosen by the AI client and is not enough on its own.
# KICAD_AI_TOOLS_ALLOW_BOM_GENERATOR=

# Offline plugin-inspection quarantine (L3). Optional; default: <LocalAppData>/kicad-mcp/quarantine.
# KICAD_MCP_QUARANTINE_ROOT=

# KiCad's own overrides, followed by the plugin inventory exactly as KiCad follows them. Optional.
# KICAD_CONFIG_HOME=
# KICAD10_3RD_PARTY=
