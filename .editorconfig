root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{py,pyw}]
indent_style = space
indent_size = 4

[*.{json,toml,yaml,yml,md}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[kicad_mcp/l4/registry/*.json]
# approved by the sha256 of its exact bytes: never reformat
insert_final_newline = unset
trim_trailing_whitespace = unset
